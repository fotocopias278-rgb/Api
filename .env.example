# --- Aplicación ---
ENVIRONMENT=local            # local | test | staging | production
DEBUG=false
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# --- Seguridad ---
# Claves de API separadas por comas. Genera una con:
#   python -c "from app.core.security import generate_api_key; print(generate_api_key())"
API_KEYS=finai_cambia_esta_clave

# --- Base de datos ---
DATABASE_URL=postgresql+asyncpg://finai:finai@db:5432/finai
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- Redis / Celery ---
REDIS_URL=redis://cache:6379/0
# Por defecto ambos usan REDIS_URL:
# CELERY_BROKER_URL=redis://cache:6379/0
# CELERY_RESULT_BACKEND=redis://cache:6379/1

# --- Stripe ---
# Sin estas claves la pasarela funciona en modo simulado (no mueve dinero real).
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# --- IA / Visión ---
# Sin clave, la extracción de comprobantes usa un stub que nunca da por bueno
# un documento: todo queda pendiente de revisión manual.
ANTHROPIC_API_KEY=
VISION_MODEL=claude-opus-5
VISION_MAX_TOKENS=8000
VISION_TIMEOUT_SECONDS=120

# --- Limitación de tasa ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
# Ráfaga máxima admitida; 0 = un minuto entero de cupo.
RATE_LIMIT_BURST=0
# Si Redis cae: true deja pasar el tráfico (se degrada), false lo rechaza.
RATE_LIMIT_FAIL_OPEN=true

# --- Motor de fraude ---
FRAUD_REVIEW_THRESHOLD=40
FRAUD_REJECT_THRESHOLD=75
FRAUD_HIGH_AMOUNT_MINOR=500000
FRAUD_VELOCITY_MAX_PER_HOUR=5
FRAUD_MAX_DISTINCT_CARDS_PER_DAY=3
FRAUD_BLOCKED_BINS=

# --- Conciliación ---
RECONCILIATION_AMOUNT_TOLERANCE_MINOR=100
RECONCILIATION_DATE_WINDOW_HOURS=72
RECEIPT_MAX_BYTES=10485760
RECEIPT_STORAGE_DIR=./var/receipts
